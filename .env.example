APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# =============================================================================
# CACHE & PERFORMANCE
# =============================================================================

CACHE_STORE=redis
CACHE_PREFIX=omni_portal_

# =============================================================================
# SEO INDEXING API
# =============================================================================

# Google Indexing API (Service Account JSON)
# Get credentials from Google Cloud Console > APIs > Indexing API
GOOGLE_INDEXING_CREDENTIALS=
GOOGLE_INDEXING_SERVICE_ACCOUNT=

# Bing Index Now API
# Get API key from Bing Webmaster Tools
BING_INDEXING_API_KEY=

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Admin Panel IP Whitelist (comma-separated, leave empty for all)
# Examples: 192.168.1.100, 10.0.0.0/24, 172.16.0.1-172.16.0.50
ADMIN_WHITELIST=

# API IP Whitelist (comma-separated, leave empty for all)
API_WHITELIST=

# API Rate Limiting
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_DECAY=60

# =============================================================================
# GOOGLE ADSENSE & ANALYTICS
# =============================================================================

# AdSense (Get from: adsense.google.com)
# Publisher ID: ca-pub-xxxxxxxxxxxxx
# Ad Client: ca-pub-xxxx (same as publisher)
# Ad Slots: Get from AdSense > My ads > Ad units
ADSENSE_PUBLISHER_ID=
ADSENSE_AD_CLIENT=
ADSENSE_AD_SLOT_HEADER=
ADSENSE_AD_SLOT_SIDEBAR=
ADSENSE_AD_SLOT_INARTICLE=
ADSENSE_AD_SLOT_FOOTER=
# ADSENSE_ENABLED=true  # Auto-enabled when publisher_id and ad_client set

# Google Analytics 4 (Get from: analytics.google.com)
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_PROPERTY_ID=

# Google Search Console Verification (meta tag content)
GSC_VERIFICATION=

# Admin contact info (used in sellers.json and meta tags)
ADMIN_EMAIL=admin@example.com
APP_ADDRESS=

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": true,
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./vendor/**)",
      "Read(./storage/**)",
      "Read(./bootstrap/cache/**)",
      "Read(./public/build/**)",
      "Read(./dist/**)",
      "Read(./coverage/**)",
      "Read(./tmp/**)",
      "Read(./.git/**)",
      "Read(./.idea/**)",
      "Read(./.vscode/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
